{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dialogue_id": {
      "type": "string",
      "pattern": "^D(00[1-9]|0[1-3][0-9]|040)$"
    },
    "review_status": {
      "enum": [
        "pending",
        "verified"
      ]
    },
    "guilt": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            0,
            1,
            null
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "turn": {
                "type": "string",
                "pattern": "^A[1-6]$"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "turn",
              "quote",
              "explanation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "additionalProperties": false
    },
    "nat": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "problem_fragments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "turn": {
                "type": "string",
                "pattern": "^A[1-6]$"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "turn",
              "quote",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "explanation": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "problem_fragments",
        "explanation"
      ],
      "additionalProperties": false
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^G(0[1-9]|1[0-5])$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "turn": {
                  "type": "string",
                  "pattern": "^A[1-6]$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "turn",
                "quote",
                "explanation"
              ],
              "additionalProperties": false
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "evidence",
          "explanation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "dialogue_id",
    "review_status",
    "guilt",
    "nat",
    "occurrences"
  ],
  "additionalProperties": false
}
